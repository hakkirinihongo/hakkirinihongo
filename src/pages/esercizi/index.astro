---
import BaseLayout from '../../layouts/BaseLayout.astro';

const exerciseModules = import.meta.glob('../../data/esercizi/*.json', { eager: true });

const exercises = Object.values(exerciseModules)
  .map((mod) => mod.default)
  .sort((a, b) =>
    (a.shortTitle ?? a.title).localeCompare(
      b.shortTitle ?? b.title,
      'ja'
    )
  );

const jlptOrder = ['N5', 'N4', 'N3', 'N2', 'N1'];

const availableJlpt = [
  ...new Set(
    exercises
      .map((exercise) => exercise.jlpt)
      .filter(Boolean)
  )
].sort((a, b) => {
  const aIndex = jlptOrder.indexOf(a);
  const bIndex = jlptOrder.indexOf(b);

  if (aIndex === -1 && bIndex === -1) {
    return String(a).localeCompare(String(b));
  }

  if (aIndex === -1) return 1;
  if (bIndex === -1) return -1;

  return aIndex - bIndex;
});

const availableAreas = [
  ...new Set(
    exercises
      .map((exercise) => exercise.area)
      .filter(Boolean)
  )
];

const areaLabels = {
  grammatica: 'Grammatica',
  'parole-e-sfumature': 'Parole e sfumature',
  'uso-e-contesto': 'Uso e contesto',
};

const showSearch = exercises.length >= 6;
const showJlptFilters = availableJlpt.length >= 2;
const showAreaFilters = availableAreas.length >= 2;
const showControls = showSearch || showJlptFilters || showAreaFilters;
---

<BaseLayout
  title="Esercizi di giapponese | Hakkiri Nihongo"
  description="Esercizi di grammatica e lessico giapponese basati sugli articoli di Hakkiri Nihongo. Quiz a risposta multipla con correzione e spiegazione."
  alternateItalian="/esercizi/"
  alternateEnglish="/en/exercises/"
>
  <main class="exercises-index" data-exercises-index>
    <header class="exercises-index-header">
      <p class="exercises-index-label">Hakkiri Nihongo</p>

      <h1>Esercizi</h1>

      <p class="exercises-index-intro">
        Metti alla prova grammatica, lessico e sfumature del giapponese con esercizi collegati agli articoli di Hakkiri Nihongo.
      </p>
    </header>

    {showControls && (
      <section
        class="exercise-filters"
        aria-label="Filtra gli esercizi"
      >
        {showSearch && (
          <div class="exercise-search">
            <label for="exercise-search-input">
              Cerca un esercizio
            </label>

            <input
              id="exercise-search-input"
              type="search"
              placeholder="Es. させてもらう, sasete morau, permesso..."
              autocomplete="off"
              data-exercise-search
            />
          </div>
        )}

        {showJlptFilters && (
          <div class="exercise-filter-group">
            <p class="exercise-filter-title">JLPT</p>

            <div class="exercise-filter-buttons">
              <button
                type="button"
                class="is-active"
                data-jlpt-filter=""
              >
                Tutti
              </button>

              {availableJlpt.map((level) => (
                <button
                  type="button"
                  data-jlpt-filter={level}
                >
                  {level}
                </button>
              ))}
            </div>
          </div>
        )}

        {showAreaFilters && (
          <div class="exercise-filter-group">
            <p class="exercise-filter-title">Area</p>

            <div class="exercise-filter-buttons">
              <button
                type="button"
                class="is-active"
                data-area-filter=""
              >
                Tutti
              </button>

              {availableAreas.map((area) => (
                <button
                  type="button"
                  data-area-filter={area}
                >
                  {areaLabels[area] ?? area}
                </button>
              ))}
            </div>
          </div>
        )}
      </section>
    )}

    {exercises.length > 0 ? (
      <>
        <div class="exercises-grid" data-exercises-grid>
          {exercises.map((exercise) => {
            const searchText = [
              exercise.title,
              exercise.shortTitle,
              exercise.description,
              ...(exercise.searchTerms ?? [])
            ]
              .filter(Boolean)
              .join(' ')
              .toLowerCase();

            return (
              <article
                class="exercise-index-card"
                data-exercise-card
                data-search={searchText}
                data-jlpt={exercise.jlpt ?? ''}
                data-area={exercise.area ?? ''}
              >
                <div class="exercise-index-card-body">
                  <p class="exercise-index-card-label">
                    Esercizio
                  </p>

                  <h2>
                    <a href={`/esercizi/${exercise.slug}/`}>
                      {exercise.shortTitle ?? exercise.title}
                    </a>
                  </h2>

                  <p class="exercise-index-card-description">
                    {exercise.description}
                  </p>

                  <div class="exercise-index-card-meta">
                    <span>{exercise.questions.length} domande</span>

                    {exercise.jlpt && (
                      <span>JLPT {exercise.jlpt}</span>
                    )}
                  </div>

                  <div class="exercise-index-card-actions">
                    <a
                      class="exercise-index-start"
                      href={`/esercizi/${exercise.slug}/`}
                    >
                      Inizia l'esercizio →
                    </a>

                    {exercise.articleSlug && (
                      <a
                        class="exercise-index-article"
                        href={`/articoli/${exercise.articleSlug}/`}
                      >
                        Leggi l'articolo
                      </a>
                    )}
                  </div>
                </div>
              </article>
            );
          })}
        </div>

        <p
          class="exercise-no-results"
          data-exercise-no-results
          hidden
        >
          Nessun esercizio corrisponde ai filtri selezionati.
        </p>
      </>
    ) : (
      <p>Nessun esercizio disponibile.</p>
    )}
  </main>
</BaseLayout>

<script>
  const exercisesIndex = document.querySelector("[data-exercises-index]");

  if (exercisesIndex instanceof HTMLElement) {
    const cards = Array.from(
      exercisesIndex.querySelectorAll("[data-exercise-card]")
    );

    const searchInput = exercisesIndex.querySelector("[data-exercise-search]");
    const jlptButtons = Array.from(
      exercisesIndex.querySelectorAll("[data-jlpt-filter]")
    );
    const areaButtons = Array.from(
      exercisesIndex.querySelectorAll("[data-area-filter]")
    );

    const noResults = exercisesIndex.querySelector(
      "[data-exercise-no-results]"
    );

    let activeJlpt = "";
    let activeArea = "";
    let searchQuery = "";

    const applyFilters = () => {
      let visibleCount = 0;

      cards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return;

        const cardSearch = card.dataset.search ?? "";
        const cardJlpt = card.dataset.jlpt ?? "";
        const cardArea = card.dataset.area ?? "";

        const matchesSearch =
          !searchQuery ||
          cardSearch.includes(searchQuery);

        const matchesJlpt =
          !activeJlpt ||
          cardJlpt === activeJlpt;

        const matchesArea =
          !activeArea ||
          cardArea === activeArea;

        const visible =
          matchesSearch &&
          matchesJlpt &&
          matchesArea;

        card.hidden = !visible;

        if (visible) {
          visibleCount += 1;
        }
      });

      if (noResults instanceof HTMLElement) {
        noResults.hidden = visibleCount !== 0;
      }
    };

    if (searchInput instanceof HTMLInputElement) {
      searchInput.addEventListener("input", () => {
        searchQuery = searchInput.value
          .trim()
          .toLowerCase();

        applyFilters();
      });
    }

    jlptButtons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;

      button.addEventListener("click", () => {
        activeJlpt = button.dataset.jlptFilter ?? "";

        jlptButtons.forEach((item) => {
          item.classList.toggle(
            "is-active",
            item === button
          );
        });

        applyFilters();
      });
    });

    areaButtons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;

      button.addEventListener("click", () => {
        activeArea = button.dataset.areaFilter ?? "";

        areaButtons.forEach((item) => {
          item.classList.toggle(
            "is-active",
            item === button
          );
        });

        applyFilters();
      });
    });
  }
</script>

<style>
  [hidden] {
    display: none !important;
  }

  .exercises-index {
    width: min(1080px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 4rem 0 6rem;
  }

  .exercises-index-header {
    max-width: 760px;
    margin-bottom: 2.75rem;
  }

  .exercises-index-label {
    margin: 0 0 0.45rem;
    color: #8f2f28;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .exercises-index-header h1 {
    margin: 0;
    font-family: "Cormorant Garamond", serif;
    font-size: clamp(2.6rem, 6vw, 4.5rem);
    font-weight: 600;
    line-height: 1;
  }

  .exercises-index-intro {
    max-width: 700px;
    margin: 1.2rem 0 0;
    font-size: 1.12rem;
    line-height: 1.7;
  }

  .exercise-filters {
    margin: -0.5rem 0 2.5rem;
    padding: 1.25rem 1.35rem;
    border: 1px solid #eadfd2;
    border-radius: 18px;
    background: rgba(252, 249, 245, 0.72);
  }

  .exercise-search label,
  .exercise-filter-title {
    display: block;
    margin: 0 0 0.55rem;
    font-size: 0.84rem;
    font-weight: 700;
  }

  .exercise-search input {
    width: 100%;
    padding: 0.8rem 0.95rem;
    border: 1px solid #ddd4ca;
    border-radius: 12px;
    background: #fff;
    color: inherit;
    font: inherit;
  }

  .exercise-search input:focus {
    outline: 2px solid rgba(143, 47, 40, 0.22);
    outline-offset: 2px;
  }

  .exercise-filter-group {
    margin-top: 1rem;
  }

  .exercise-filter-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .exercise-filter-buttons button {
    padding: 0.48rem 0.8rem;
    border: 1px solid #ddd4ca;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .exercise-filter-buttons button.is-active {
    border-color: #8f2f28;
    background: rgba(143, 47, 40, 0.07);
    color: #8f2f28;
    font-weight: 700;
  }

  .exercises-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.3rem;
  }

  .exercise-index-card {
    border: 1px solid #eadfd2;
    border-radius: 20px;
    background: rgba(252, 249, 245, 0.9);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.035);
  }

  .exercise-index-card-body {
    padding: 1.5rem;
  }

  .exercise-index-card-label {
    margin: 0 0 0.4rem;
    color: #8f2f28;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .exercise-index-card h2 {
    margin: 0;
    font-family: "Cormorant Garamond", serif;
    font-size: 1.65rem;
    line-height: 1.25;
  }

  .exercise-index-card h2 a {
    color: inherit;
    text-decoration: none;
  }

  .exercise-index-card h2 a:hover {
    color: #8f2f28;
  }

  .exercise-index-card-description {
    margin: 0.8rem 0 0;
    line-height: 1.6;
  }

  .exercise-index-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: 1rem;
    font-size: 0.9rem;
    opacity: 0.72;
  }

  .exercise-index-card-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.1rem;
    margin-top: 1.25rem;
  }

  .exercise-index-start {
    color: #8f2f28;
    font-weight: 700;
    text-decoration: none;
  }

  .exercise-index-start:hover {
    text-decoration: underline;
  }

  .exercise-index-article {
    color: inherit;
    font-size: 0.9rem;
  }

  .exercise-no-results {
    margin: 2rem 0 0;
    text-align: center;
    opacity: 0.72;
  }

  @media (max-width: 720px) {
    .exercises-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
