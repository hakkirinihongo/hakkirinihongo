
---
import BaseLayout from '../../layouts/BaseLayout.astro';

const postModules = import.meta.glob(
  '../../content/grammatica-base/**/*.mdx',
  { eager: true }
);

const posts = Object.entries(postModules).map(([path, mod]) => {
  const fm = mod.frontmatter ?? {};
  const fallbackSlug = path.split('/').pop().replace(/\.mdx?$/, '');

  return {
    slug: fm.slug ?? fallbackSlug,
    title: fm.title ?? fallbackSlug,
    description: fm.description ?? '',
    date: fm.date ?? '',
    image: fm.image ?? '/og-image.png'
  };
});

posts.sort((a, b) =>
  new Date(b.date).getTime() - new Date(a.date).getTime()
);
---

<BaseLayout
  title="Grammatica giapponese di base | Hakkiri Nihongo"
  description="Una biblioteca di approfondimenti sulla grammatica giapponese di base: regole, significati, sfumature e spiegazioni dettagliate."
>
  <div class="page-articles page-articles-bg hn-basic-library">

    <h1>Grammatica di base</h1>

    <p class="basic-library-intro">
      Una biblioteca dedicata alle strutture fondamentali
      della lingua giapponese, alle loro sfumature e
      al loro funzionamento.

      Ogni articolo affronta un argomento specifico e ne approfondisce anche gli aspetti che le spiegazioni in genere tendono a semplificare.
    </p>

    <ul class="post-list">
      {posts.map((post) => (
        <li class="post-item">

          <a
            class="post-thumb"
            href={`/grammatica-di-base/${post.slug}/`}
            aria-hidden="true"
            tabindex="-1"
          >
            <img
              src={post.image}
              alt=""
              loading="lazy"
            />
          </a>

          <div class="post-content">
            <h2 class="post-title">
              <a
                class="post-link"
                href={`/grammatica-di-base/${post.slug}/`}
              >
                {post.title}
              </a>
            </h2>

            {post.description && (
              <p class="post-description">
                {post.description}
              </p>
            )}

            {post.date && (
              <div class="post-meta">
                <time datetime={post.date}>
                  {new Date(post.date).toLocaleDateString('it-IT')}
                </time>
              </div>
            )}
          </div>

        </li>
      ))}
    </ul>

    {posts.length === 0 && (
      <p>
        Pagina in costruzione.
        I primi approfondimenti saranno disponibili a breve.
      </p>
    )}

  </div>
</BaseLayout>
