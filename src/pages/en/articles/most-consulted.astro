---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const italianPostImports = import.meta.glob(
  '../../../content/articoli/**/*.mdx'
);

const englishPostImports = import.meta.glob(
  '../../../content/en/**/*.mdx'
);

async function createArticleMetadata(
  postImports,
  basePath
) {
  return Promise.all(
    Object.entries(postImports).map(
      async ([path, resolver]) => {
        const mod = await resolver();
        const frontmatter =
          mod.frontmatter ?? {};
        const slug =
          frontmatter.slug ??
          path
            .split('/')
            .pop()
            .replace(/\.mdx?$/, '');

        return {
          path: `${basePath}${slug}/`,
          title:
            frontmatter.title ?? slug,
          description:
            frontmatter.description ?? '',
          image:
            frontmatter.image ??
            '/og-image.png',
        };
      }
    )
  );
}

const articleMetadata = [
  ...(await createArticleMetadata(
    italianPostImports,
    '/articoli/'
  )),
  ...(await createArticleMetadata(
    englishPostImports,
    '/en/articles/'
  )),
];
---

<BaseLayout
  title="Most popular articles in the last 24 hours | Hakkiri Nihongo"
  description="The most popular Japanese grammar articles on Hakkiri Nihongo over the last 24 hours, in a ranking updated automatically."
  alternateItalian="/articoli/piu-consultati/"
>
  <div class="page-articles page-articles-bg popular-page">
    <header class="popular-header">
      <p class="popular-kicker">Trending on Hakkiri Nihongo</p>

      <h1>Most popular articles in the last 24 hours</h1>

      <p class="popular-intro">
        A dynamic ranking of the in-depth articles currently receiving the most
        attention. Results are updated automatically based on activity over the
        last 24 hours.
      </p>

      <p
        id="popular-updated"
        class="popular-updated"
        aria-live="polite"
      ></p>
    </header>

    <ol
      id="popular-list"
      class="post-list popular-list"
      aria-live="polite"
      aria-busy="true"
    >
      <li class="popular-state">
        Calculating the ranking…
      </li>
    </ol>

    <noscript>
      <p class="popular-state">
        JavaScript must be enabled to view the ranking.
      </p>
    </noscript>
  </div>

  <script define:vars={{ articleMetadata }}>
    (() => {
      const endpoint =
        '/.netlify/functions/popular-articles?limit=10';

      const list =
        document.getElementById('popular-list');

      const updated =
        document.getElementById('popular-updated');

      if (!(list instanceof HTMLOListElement)) {
        return;
      }

      const articlesByPath = new Map(
        articleMetadata.map((article) => [
          article.path,
          article,
        ])
      );

      function createLink(
        className,
        href
      ) {
        const link =
          document.createElement('a');

        link.className = className;
        link.href = href;

        return link;
      }

      function createRankingItem(
        ranking,
        index
      ) {
        const article =
          articlesByPath.get(ranking.path);

        if (!article) {
          return null;
        }

        const item =
          document.createElement('li');

        item.className =
          'post-item popular-item';

        item.dataset.rank =
          String(index + 1);

        const rank =
          document.createElement('span');

        rank.className = 'popular-rank';
        rank.textContent = String(index + 1);
        rank.setAttribute(
          'aria-label',
          `Rank ${index + 1}`
        );

        const thumbnail = createLink(
          'post-thumb',
          article.path
        );

        thumbnail.setAttribute(
          'aria-hidden',
          'true'
        );

        thumbnail.tabIndex = -1;

        const image =
          document.createElement('img');

        image.src = article.image;
        image.alt = '';
        image.loading =
          index < 3 ? 'eager' : 'lazy';

        thumbnail.append(image);

        const content =
          document.createElement('div');

        content.className = 'post-content';

        const title =
          document.createElement('h3');

        title.className = 'post-title';

        const titleLink = createLink(
          'post-link',
          article.path
        );

        titleLink.textContent = article.title;
        title.append(titleLink);
        content.append(title);

        if (article.description) {
          const description =
            document.createElement('p');

          description.className =
            'post-description';

          const descriptionLink = createLink(
            'post-link',
            article.path
          );

          descriptionLink.textContent =
            article.description;

          description.append(
            descriptionLink
          );

          content.append(description);
        }

        item.append(
          rank,
          thumbnail,
          content
        );

        return item;
      }

      function showState(message) {
        const state =
          document.createElement('li');

        state.className = 'popular-state';
        state.textContent = message;

        list.replaceChildren(state);
      }

      function renderRanking(payload) {
        const items = [];

        for (
          const ranking of payload.articles || []
        ) {
          const item = createRankingItem(
            ranking,
            items.length
          );

          if (item) {
            items.push(item);
          }
        }

        if (!items.length) {
          showState(
            'The ranking does not contain enough data yet.'
          );

          return;
        }

        list.replaceChildren(...items);

        if (
          updated &&
          payload.generated_at
        ) {
          const time = new Date(
            payload.generated_at
          ).toLocaleTimeString(
            'en-GB',
            {
              timeZone: 'Europe/Rome',
              hour: '2-digit',
              minute: '2-digit',
            }
          );

          updated.textContent =
            `Ranking updated at ${time}`;
        }
      }

      async function loadRanking() {
        list.setAttribute(
          'aria-busy',
          'true'
        );

        try {
          const response = await fetch(
            endpoint,
            {
              headers: {
                Accept: 'application/json',
              },
            }
          );

          if (!response.ok) {
            throw new Error(
              'Request failed.'
            );
          }

          const payload =
            await response.json();

          renderRanking(payload);
        } catch {
          showState(
            'The ranking is temporarily unavailable.'
          );

          if (updated) {
            updated.textContent = '';
          }
        } finally {
          list.setAttribute(
            'aria-busy',
            'false'
          );
        }
      }

      loadRanking();

      window.setInterval(
        loadRanking,
        5 * 60 * 1000
      );
    })();
  </script>

  <style is:global>
    .popular-page {
      padding-bottom: 2rem;
    }

    .popular-header {
      max-width: 850px;
    }

    .popular-kicker {
      margin: 0 0 0.55rem;
      font-family: "Cormorant Garamond", Georgia, serif;
      font-size: 1.08rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: #9f2f27;
    }

    .popular-page h1 {
      margin: 0;
      font-family: "Playfair Display", Georgia, serif;
      font-size: clamp(2rem, 5vw, 3rem);
      line-height: 1.14;
      color: #2f2925;
    }

    .popular-intro {
      max-width: 760px !important;
      margin: 1rem 0 0 !important;
      font-family: "Cormorant Garamond", Georgia, serif !important;
      font-size: 1.18rem !important;
      line-height: 1.58 !important;
      color: #493d37 !important;
    }

    .popular-updated {
      min-height: 1.3rem;
      margin: 0.7rem 0 0 !important;
      font-family: system-ui, -apple-system, "Segoe UI", sans-serif !important;
      font-size: 0.78rem !important;
      color: #766d66 !important;
    }

    .popular-list {
      margin-top: 1.3rem;
    }

    .popular-item {
      position: relative;
    }

    .popular-rank {
      position: absolute;
      z-index: 2;
      top: 2rem;
      left: 0.7rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.4rem;
      height: 2.4rem;
      border: 2px solid rgba(255, 255, 255, 0.9);
      border-radius: 999px;
      background: #8f2d27;
      box-shadow: 0 7px 18px rgba(55, 30, 24, 0.24);
      font-family: "Playfair Display", Georgia, serif;
      font-size: 1.05rem;
      font-weight: 600;
      line-height: 1;
      color: #fffdf9;
    }

    .popular-item[data-rank="1"] .popular-rank {
      background: linear-gradient(135deg, #c6953f, #9c6825);
    }

    .popular-item[data-rank="2"] .popular-rank {
      background: linear-gradient(135deg, #8d949c, #646c74);
    }

    .popular-item[data-rank="3"] .popular-rank {
      background: linear-gradient(135deg, #ad724d, #7d4930);
    }

    .popular-state {
      padding: 2rem 0;
      color: #6c625c;
      font-style: italic;
    }

    @media (max-width: 760px) {
      .popular-rank {
        top: 2rem;
        left: 0.7rem;
      }

      .popular-page h1 {
        font-size: clamp(1.9rem, 9vw, 2.5rem);
      }

      .popular-intro {
        font-size: 1.08rem !important;
      }
    }
  </style>
</BaseLayout>