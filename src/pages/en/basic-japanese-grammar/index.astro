
---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const postModules = import.meta.glob(
  '../../../content/basic-grammar/**/*.mdx',
  { eager: true }
);

const posts = Object.entries(postModules).map(([path, mod]) => {
  const fm = mod.frontmatter ?? {};
  const fallbackSlug = path.split('/').pop().replace(/\.mdx?$/, '');

  return {
    slug: fm.slug ?? fallbackSlug,
    title: fm.title ?? fallbackSlug,
    description: fm.description ?? '',
    date: fm.date ?? '',
    image: fm.image ?? '/og-image.png'
  };
});

posts.sort((a, b) =>
  new Date(b.date).getTime() - new Date(a.date).getTime()
);
---

<BaseLayout
  title="Basic Japanese Grammar: In-Depth Guides | Hakkiri Nihongo"
  description="Explore basic Japanese grammar in depth, with clear explanations of essential structures, how they work, and the nuances behind familiar rules."
>
  <div class="page-articles page-articles-bg hn-basic-library">

    <h1>Basic Japanese Grammar</h1>

<p class="basic-library-intro">
  A library dedicated to the fundamentals of Japanese grammar, exploring how essential structures work and the nuances behind them. 

Each article explores a specific topic in depth, including aspects that introductory explanations tend to simplify.
</p>

    <ul class="post-list">
      {posts.map((post) => (
        <li class="post-item">

          <a
            class="post-thumb"
            href={`/en/basic-japanese-grammar/${post.slug}/`}
            aria-hidden="true"
            tabindex="-1"
          >
            <img
              src={post.image}
              alt=""
              loading="lazy"
            />
          </a>

          <div class="post-content">
            <h2 class="post-title">
              <a
                class="post-link"
                href={`/en/basic-japanese-grammar/${post.slug}/`}
              >
                {post.title}
              </a>
            </h2>

            {post.description && (
              <p class="post-description">
                {post.description}
              </p>
            )}

            {post.date && (
              <div class="post-meta">
                <time datetime={post.date}>
                  {new Date(post.date).toLocaleDateString('en-US', {
                  month: 'long',
                  day: 'numeric',
                  year: 'numeric'
                  })}
                </time>
              </div>
            )}
          </div>

        </li>
      ))}
    </ul>

    {posts.length === 0 && (
  <p>
    Our library is taking shape.
    The first in-depth guides will be available soon.
  </p>
)}

  </div>
</BaseLayout>
