---
const { exerciseSlug } = Astro.props;

const exerciseModules = import.meta.glob('../data/esercizi/*.json', { eager: true });

const exercises = Object.values(exerciseModules).map((mod) => mod.default);

const exercise = exercises.find((item) => item.slug === exerciseSlug);

if (!exercise) {
  throw new Error(`Esercizio collegato non trovato: ${exerciseSlug}`);
}
---

<aside class="article-exercise-card" aria-label={`Esercizi: ${exercise.title}`}>
  <div class="article-exercise-card-content">
    <p class="article-exercise-card-label">Esercizi</p>

    <h2 class="article-exercise-card-title">
      {exercise.title}
    </h2>

    <p class="article-exercise-card-description">
      {exercise.description}
    </p>

    <div class="article-exercise-card-meta">
      <span>{exercise.questions.length} domande</span>
      <span>JLPT {exercise.jlpt}</span>
    </div>

    <a
      class="article-exercise-card-link"
      href={`/esercizi/${exercise.slug}/`}
    >
      Inizia l'esercizio
      <span aria-hidden="true">→</span>
    </a>
  </div>
</aside>

<style>
  .article-exercise-card {
    margin: 2rem 0;
    padding: clamp(1.25rem, 3vw, 1.7rem);
    border: 1px solid rgba(90, 70, 55, 0.18);
    border-radius: 16px;
    background: rgba(251, 248, 244, 0.72);
  }

  .article-exercise-card-content {
    max-width: 680px;
  }

  .article-exercise-card-label {
    margin: 0 0 0.4rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .article-exercise-card-title {
    margin: 0;
    font-size: clamp(1.3rem, 3vw, 1.6rem);
    line-height: 1.3;
  }

  .article-exercise-card-description {
    margin: 0.75rem 0 0;
    line-height: 1.65;
  }

  .article-exercise-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: 0.9rem;
    font-size: 0.9rem;
    opacity: 0.8;
  }

  .article-exercise-card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.15rem;
    padding: 0.7rem 1.15rem;
    border: 1px solid rgba(90, 70, 55, 0.25);
    border-radius: 999px;
    color: inherit;
    text-decoration: none;
    font-weight: 600;
    transition:
      transform 0.18s ease,
      background-color 0.18s ease;
  }

  .article-exercise-card-link:hover {
    background: rgba(90, 70, 55, 0.07);
    transform: translateY(-1px);
  }
</style>
